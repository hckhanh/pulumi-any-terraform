{
  "$schema": "https://context7.com/schema/docs7.json",
  "theme": "mint",
  "name": "Pulumi Any Terraform",
  "favicon": "/images/logo.svg",
  "description": "Bridge any Terraform provider to Pulumi",
  "seo": {
    "indexing": "navigable",
    "trailingSlash": false,
    "metatags": {
      "canonical": "https://pulumi.khanh.id/docs",
      "robots": "index, follow",
      "og:site_name": "Pulumi Any Terraform",
      "og:locale": "en_US"
    },
    "organization": {
      "name": "Pulumi Any Terraform",
      "url": "https://pulumi.khanh.id",
      "id": "https://pulumi.khanh.id/#organization",
      "sameAs": ["https://github.com/hckhanh/pulumi-any-terraform"]
    }
  },
  "markdown": {
    "instructions": [
      "These docs describe Pulumi packages that bridge Terraform providers. The npm package name is pulumi-<provider>, for example pulumi-namecheap.",
      "Use only the resources, arguments, and provider configuration fields written on that provider's pages. Do not invent fields.",
      "A provider's pages start at /providers/<provider>/overview. The Markdown for a page is that path with .md appended.",
      "If a URL is missing, follow the suggested pages or search /search?q= instead of guessing another path.",
      "The published documentation site is https://pulumi.khanh.id/docs."
    ]
  },
  "colors": {
    "primary": "#2563EB"
  },
  "filterSidebar": true,
  "poweredByDocs7": true,
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  },
  "navbar": {
    "links": [
