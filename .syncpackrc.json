{
  "$schema": "./node_modules/syncpack/schema.json",
  "sortFirst": [
    "name",
    "description",
    "version",
    "productName",
    "author",
    "homepage",
    "repository",
    "private",
    "sideEffects",
    "type",
    "main",
    "module",
    "types",
    "exports",
    "scripts",
    "dependencies",
    "devDependencies",
    "peerDependencies",
    "trustedDependencies",
    "workspaces",
    "packageManager"
  ],
  "sortExports": ["import", "types"],
  "sortAz": [
    "exports",
    "scripts",
    "workspaces",
    "dependencies",
    "devDependencies",
    "peerDependencies",
    "trustedDependencies"
  ],
  "versionGroups": [
    {
      "label": "Peer dependencies can be ignored",
      "dependencies": ["**"],
      "dependencyTypes": ["peer"],
      "packages": ["**"],
      "isIgnored": true
    },
    {
      "label": "Root workspace package is private and unversioned",
      "dependencyTypes": ["local"],
      "packages": ["pulumi-any-terraform"],
      "isIgnored": true
    }
  ],
  "semverGroups": [
    {
      "label": "All dependencies must be pinned, except resolutions and pnpm-workspace.yaml overrides",
      "dependencyTypes": ["!resolutions", "!pnpmOverrides"],
      "dependencies": ["**"],
      "packages": ["**"],
      "range": ""
    }
  ]
}
