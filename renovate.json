{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "config:js-app",
    ":automergePr",
    ":automergeMinor",
    ":automergeTypes",
    "security:minimumReleaseAgeNpm",
    "group:definitelyTyped",
    "schedule:nonOfficeHours",
    ":separateMultipleMajorReleases",
    "schedule:automergeNonOfficeHours",
    ":automergeRequireAllStatusChecks",
    ":preserveSemverRanges"
  ],
  "postUpdateOptions": ["pnpmDedupe"],
  "timezone": "Asia/Ho_Chi_Minh",
  "internalChecksFilter": "strict",
  "packageRules": [
    {
      "description": "Keep mise.toml and pnpm/setup workflow pins in the same PR",
      "groupName": "node",
      "matchDatasources": ["node-version"],
      "matchPackageNames": ["node"]
    },
    {
      "description": "Keep mise.toml and pnpm/setup workflow pins in the same PR",
      "groupName": "pnpm",
      "matchDatasources": ["npm"],
      "matchPackageNames": ["pnpm"]
    },
    {
      "description": "Match pnpm minimumReleaseAge of 2880 minutes so lockfile updates are not attempted before pnpm will accept them",
      "matchDatasources": ["npm"],
      "matchUpdateTypes": ["major", "minor", "patch", "digest", "pinDigest"],
      "minimumReleaseAge": "2 days",
      "internalChecksFilter": "strict"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track pinned npm CLI version in workflow run blocks",
      "managerFilePatterns": ["/^\\.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": ["run: npm install -g npm@(?<currentValue>\\S+)"],
      "datasourceTemplate": "npm",
      "depNameTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Track pnpm version in pnpm/setup workflow inputs",
      "managerFilePatterns": ["/^\\.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": ["version: (?<currentValue>\\S+)\\n\\s+runtime: node@"],
      "datasourceTemplate": "npm",
      "depNameTemplate": "pnpm",
      "versioningTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Track Node.js version in pnpm/setup runtime inputs",
      "managerFilePatterns": ["/^\\.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": ["runtime: node@(?<currentValue>\\S+)"],
      "datasourceTemplate": "node-version",
      "depNameTemplate": "node",
      "versioningTemplate": "node"
    }
  ]
}
