{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "config:js-app",
    ":automergePr",
    ":automergeMinor",
    ":automergeTypes",
    "security:minimumReleaseAgeNpm",
    "group:definitelyTyped",
    "schedule:nonOfficeHours",
    ":separateMultipleMajorReleases",
    "schedule:automergeNonOfficeHours",
    ":automergeRequireAllStatusChecks",
    ":preserveSemverRanges"
  ],
  "postUpdateOptions": ["pnpmDedupe"],
  "timezone": "Asia/Ho_Chi_Minh",
  "constraints": {
    "ghActionsLock": "v0.1.6"
  },
  "packageRules": [
    {
      "description": "Prefer tag refs; Renovate regenerates actions.lock (SHA pins) after github-actions updates",
      "matchManagers": ["github-actions"],
      "pinDigests": false
    },
    {
      "groupName": "fumadocs monorepo",
      "matchPackageNames": ["/^fumadocs-/"],
      "matchUpdateTypes": ["digest", "patch", "minor", "major"]
    },
    {
      "description": "Keep mise.toml and pnpm/setup workflow pins in the same PR",
      "groupName": "node",
      "matchDatasources": ["node-version"],
      "matchPackageNames": ["node"]
    },
    {
      "description": "Keep mise.toml and pnpm/setup workflow pins in the same PR",
      "groupName": "pnpm",
      "matchDatasources": ["npm"],
      "matchPackageNames": ["pnpm"]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track Aikido Safe Chain installer version and SHA-256 together",
      "managerFilePatterns": [
        "/^\\.github/actions/setup-safe-chain/action\\.ya?ml$/"
      ],
      "matchStrings": [
        "SAFE_CHAIN_RELEASE: (?<currentValue>\\S+)\\n\\s+SAFE_CHAIN_SHA256: (?<currentDigest>[a-f0-9]{64})"
      ],
      "datasourceTemplate": "github-release-attachments",
      "depNameTemplate": "AikidoSec/safe-chain",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Track pinned npm CLI version in workflow run blocks",
      "managerFilePatterns": ["/^\\.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": ["run: npm install -g npm@(?<currentValue>\\S+)"],
      "datasourceTemplate": "npm",
      "depNameTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Track pnpm version in pnpm/setup workflow inputs",
      "managerFilePatterns": ["/^\\.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": ["version: (?<currentValue>\\S+)\\n\\s+runtime: node@"],
      "datasourceTemplate": "npm",
      "depNameTemplate": "pnpm",
      "versioningTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Track Node.js version in pnpm/setup runtime inputs",
      "managerFilePatterns": ["/^\\.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": ["runtime: node@(?<currentValue>\\S+)"],
      "datasourceTemplate": "node-version",
      "depNameTemplate": "node",
      "versioningTemplate": "node"
    }
  ]
}
